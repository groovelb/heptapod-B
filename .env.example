# Heptapod B Encoder — 환경변수 템플릿
# 복사: cp .env.example .env
# Next.js는 아래 NEXT_PUBLIC_*만 클라이언트에 노출합니다.
# 기존 .env의 VITE_* 값도 next.config.mjs의 명시적 허용 목록으로 호환됩니다.

# 실제 배포 도메인. OG 이미지와 canonical에 사용 (서버 전용)
SITE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MUSIC_VIDEO_ID=
NEXT_PUBLIC_MUSIC_VOLUME=
NEXT_PUBLIC_MUSIC_AUTOPLAY=
NEXT_PUBLIC_ARCHIVE_RELATIONS_MODE=

# 아래는 기존 Vite 설정 호환용. 새 설정에서는 NEXT_PUBLIC_*를 우선 사용합니다.

# 배경음악 — YouTube 영상 ID (API key 불필요). 기본: Jóhann Jóhannsson — Heptapod B
VITE_MUSIC_VIDEO_ID=KzaqrQuwr1k

# 배경음악 음량 (0~100). 효과음과의 균형상 낮게 권장
VITE_MUSIC_VOLUME=20

# 배경음악 기본 재생 여부 (true|false). true면 첫 상호작용에서 자동 시작
VITE_MUSIC_AUTOPLAY=true

# 공개 아카이브 (public anon/publishable key만 사용; service role을 VITE_에 두지 않음)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 관계 계산: 미지정 시 pnpm dev는 local, production build는 api.
# local = 프론트가 읽은 실제 공개 표식으로 계산 (관계 Edge Function 호출 없음).
# api = archive-relations 호출. 배포 후 이 값만 api로 바꾸면 화면 변경 불필요.
VITE_ARCHIVE_RELATIONS_MODE=

# 이전 Edge 공유 endpoint 기록용. Next 공유는 앱 UUID 링크에서 OG를 직접 제공합니다.
# 기본 *.supabase.co 도메인은 리치 HTML/OG 공유용으로 사용할 수 없음.
VITE_ARCHIVE_SHARE_URL=
# 서버에만 설정: ARCHIVE_SITE_URL, ARCHIVE_SHARE_URL.
# 상세: docs/heptapod-b-encoder/16-resonance-implementation.md
